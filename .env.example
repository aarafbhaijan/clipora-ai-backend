# Copy to .env and adjust. Never commit .env. On AWS these come from the ECS task definition
# and Secrets Manager, and S3/Bedrock access comes from the task role (no keys).
ENV=local
DATABASE_URL=postgresql+psycopg://clipora:clipora@localhost:5432/clipora

AWS_REGION=us-east-1
# AWS_PROFILE=personal   # profile used for Bedrock locally
S3_BUCKET=clipora-local
# Region of the bucket (can differ from AWS_REGION / BEDROCK_REGION). Real S3: create the bucket with
# infra/s3/setup-dev-bucket.sh, set S3_BUCKET and S3_REGION, and remove the four S3_* local lines below.
S3_REGION=
# Local RustFS only. Leave empty on AWS.
S3_ENDPOINT_URL=http://localhost:9100
S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY_ID=clipora
S3_SECRET_ACCESS_KEY=clipora-secret

# AUTH_MODE=dev accepts "Authorization: Bearer dev:<email>" and is refused unless ENV=local.
AUTH_MODE=dev
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Agent layer (Amazon Bedrock). Set the Bedrock model or inference profile ids enabled in your account.
# Bedrock credentials come from the normal AWS chain (AWS_PROFILE locally, task role on ECS).
BEDROCK_REGION=us-east-1
LLM_PROVIDER=bedrock
# Cheapest Bedrock option: LLM_MODEL_ID=apac.amazon.nova-lite-v1:0, LLM_SMALL_MODEL_ID=apac.amazon.nova-micro-v1:0,
# LLM_STRUCTURED_METHOD=function_calling (Nova has no JSON-schema output mode; Claude uses the default json_schema).
LLM_STRUCTURED_METHOD=json_schema
# Model for streamed chat replies; defaults to LLM_MODEL_ID. Local Ollama: llama3.2:latest (qwen3 narrates).
LLM_CHAT_MODEL_ID=
LLM_MODEL_ID=
LLM_SMALL_MODEL_ID=
# Local testing without Bedrock: LLM_PROVIDER=ollama, LLM_MODEL_ID=qwen3:4b, OLLAMA_BASE_URL=http://localhost:11434,
# OLLAMA_NUM_CTX=16384, LLM_TIMEOUT_S=300, JOB_TIMEOUT_SCALE=4 (local models are slow; never scale in production).
# Groq (OpenAI-compatible API) for any tier, e.g. agentic work on Groq and chat on local Ollama:
#   LLM_PROVIDER=groq  LLM_MODEL_ID=openai/gpt-oss-120b  LLM_SMALL_MODEL_ID=openai/gpt-oss-20b
#   LLM_CHAT_PROVIDER=ollama  LLM_CHAT_MODEL_ID=llama3.2:latest  LLM_TIMEOUT_S=300
# Other Groq chat models: qwen/qwen3.8-27b, llama-3.3-70b-versatile, llama-3.1-8b-instant. LLM_SMALL_PROVIDER also exists.
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_STRUCTURED_METHOD=json_schema
# NVIDIA API catalog (OpenAI-compatible), e.g. video editing on NVIDIA, chat on Groq:
#   LLM_PROVIDER=nvidia  LLM_MODEL_ID=deepseek-ai/deepseek-v4.1-flash  (or nvidia/nemotron-3.5-lightning-30b-a3b)
#   LLM_SMALL_PROVIDER=groq  LLM_CHAT_PROVIDER=groq
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_STRUCTURED_METHOD=function_calling
# Current Claude models reject temperature/top_p/top_k (400). Leave 0 unless you use an older model.
LLM_SEND_TEMPERATURE=0
# Connections for the LangGraph checkpointer, on top of slots + 2 per agent worker.
AGENT_CHECKPOINT_POOL=4

# Frontend (frontend/.env.local)
# API_ORIGIN=http://localhost:8000
# NEXT_PUBLIC_AUTH_MODE=dev
